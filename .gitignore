# dist/ (built single-file scripts) IS committed: people download from it.
# Script output must never live in the repo (logs can hold host details).
out/
bt-out/
*.log
# Real competition data: host lists, protected lists, credential sheets.
config/*.csv
config/*.txt
!config/*.example.csv
!config/*.example.txt
# The Flokid host list: addresses from the team packet, no passwords.
!config/hosts.flokid.txt
# Editor and OS clutter
*.swp
*~
.DS_Store
Thumbs.db

# Temporary copies the test runs make of a test, pointed at dist/
tests/.d-*.test.sh
